{
  "name": "irp-renewal-tracker",
  "version": "0.1.0",
  "description": "Unofficial tracker for Irish Residence Permit (IRP) renewal processing timelines",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "collect": "node scripts/collect.ts",
    "derive": "node scripts/derive.ts",
    "update": "node scripts/collect.ts --save && node scripts/derive.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "cheerio": "^1.2.0"
  }
}
